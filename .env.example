# Copy to .env and set values.
# Run: docker compose up -d (PostgreSQL), then npm run start:dev (API).

# Server
NODE_ENV=development
PORT=3000
# CORS: leave unset to allow any origin, or set to e.g. https://myapp.com (one origin)
# CORS_ORIGIN=

# Database (PostgreSQL)
# With Docker: DB_HOST=localhost, DB_PORT=5434 (host port).
# User/password must match POSTGRES_USER/POSTGRES_PASSWORD in compose.
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=task_management

# JWT (required for auth). Change in production.
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Initial admin (optional). If set, API creates an administrator user with this email and password on first run.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=admin123
