{
  "info": {
    "name": "Task Management API",
    "description": "Auth + Users + Tasks. Set {{token}} after POST /auth/login (Bearer JWT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ejemplo.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Returns { access_token }. The token is saved automatically to {{token}} for the rest of the requests."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"María García\",\n  \"email\": \"maria@ejemplo.com\",\n  \"password\": \"password123\",\n  \"role\": \"member\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "JWT + ADMIN. Role: member | administrator."
          }
        },
        {
          "name": "List all users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "description": "JWT. Includes finishedTasksCount, totalFinishedTasksCost."
          }
        },
        {
          "name": "List users (filter by name)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?name=maría",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "name", "value": "maría" }]
            }
          }
        },
        {
          "name": "List users (filter by email)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?email=@ejemplo.com",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "email", "value": "@ejemplo.com" }]
            }
          }
        },
        {
          "name": "List users (filter by role)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users?role=member",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "role", "value": "member" }]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implementar login\",\n  \"description\": \"Pantalla de login\",\n  \"estimatedHours\": 8,\n  \"dueDate\": \"2026-03-01T18:00:00.000Z\",\n  \"status\": \"active\",\n  \"cost\": 1500.5,\n  \"assigneeIds\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] },
            "description": "JWT + ADMIN. assigneeIds = user UUIDs."
          }
        },
        {
          "name": "List all tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] },
            "description": "JWT. Newest first. Optional: title, dueDate, assigneeId, assigneeName, assigneeEmail."
          }
        },
        {
          "name": "List tasks (filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks?title=login&dueDate=2026-03-01&assigneeId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "title", "value": "login" },
                { "key": "dueDate", "value": "2026-03-01" },
                { "key": "assigneeId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "Get task by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Update task (ADMIN) PUT",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Título actualizado\",\n  \"description\": \"Desc\",\n  \"estimatedHours\": 10,\n  \"dueDate\": \"2026-03-15T18:00:00.000Z\",\n  \"status\": \"active\",\n  \"cost\": 2000,\n  \"assigneeIds\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "JWT + ADMIN. Full update."
          }
        },
        {
          "name": "Update task (ADMIN) PATCH",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Solo título\",\n  \"assigneeIds\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "JWT + ADMIN. Partial update."
          }
        },
        {
          "name": "Update task time (MEMBER/ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"actualHours\": 5\n}" },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/time",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}", "time"]
            },
            "description": "JWT + MEMBER or ADMIN. actualHours only."
          }
        },
        {
          "name": "Update task status (MEMBER/ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"finished\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}", "status"]
            },
            "description": "JWT + MEMBER or ADMIN. status: active | finished."
          }
        },
        {
          "name": "Delete task (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Tasks analytics (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tasks/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "analytics"]
            },
            "description": "JWT + ADMIN. Returns totalTasks, completedTasks, totalCost."
          }
        }
      ]
    }
  ]
}
